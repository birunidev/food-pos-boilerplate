      "displayName": "Ordered Items",
      "type": "component",
      "repeatable": true,
      "component": "order.ordered-items"
    },
    "order_status": {
      "type": "enumeration",
      "enum": [
        "pending_payment",
        "processing",
        "ready_to_serve",
        "completed"
      ]
    },
    "order_type": {
      "type": "enumeration",
      "enum": [
