{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "subtotal": {
      "type": "decimal"
    },
    "tax": {
      "type": "decimal"
    },
    "grand_total": {
      "type": "decimal"
    },
    "order_date": {
      "type": "datetime"
    },
    "table_no": {
      "type": "string"
    },
    "order_code": {
      "type": "string"
    },
    "payment_status": {
      "type": "enumeration",
      "enum": [
        "unpaid",
        "paid",
        "cancelled",
        "expired"
      ]
    },
    "paid_at": {
      "type": "datetime"
    },
    "payment_log": {
      "type": "json"
    },
    "midtrans_transaction_id": {
      "type": "string"
    },
